# --- Scoring agent -----------------------------------------------------------
# Set ONE of the two keys below. If you leave AI_PROVIDER blank, whichever key
# is present is used; set it explicitly to force a choice.
# AI_PROVIDER=anthropic | gemini
AI_PROVIDER=

# Option A — Anthropic. Needs a card on file at console.anthropic.com.
ANTHROPIC_API_KEY=
# The brief named claude-sonnet-4-6, but it does not support structured
# outputs, which the scorer depends on. Sonnet 5 does, at the same tier.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium

# Option B — Gemini. Free key at aistudio.google.com/apikey, no card required.
# At ~60 candidates a week this is likely to stay inside the free quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database ----------------------------------------------------------------
# Optional. Without these, run `npm run scan:live` to persist to a JSON file on
# disk instead. Supabase is what makes the scan unattended, not what makes it
# work.
SCAN_LOCAL_STORE_PATH=.data/scan-state.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Outbound ----------------------------------------------------------------
RESEND_API_KEY=
DIGEST_FROM=engine@yourdomain.com
DIGEST_TO=you@yourdomain.com

NOTION_API_KEY=
NOTION_OPPORTUNITY_DB_ID=

# --- Cron --------------------------------------------------------------------
# Vercel sends this as a bearer token on scheduled invocations.
CRON_SECRET=

# --- Scan budget -------------------------------------------------------------
# Hard cap on candidates scored per run. This is the API bill dial.
SCAN_MAX_CANDIDATES=60
SCAN_CONCURRENCY=4
SCAN_NOTION_TOP_N=10
SCAN_DIGEST_TOP_N=3

# Set to 1 to run the whole pipeline against local fixtures with no network
# calls, no API keys and no writes.
SCAN_DRY_RUN=0
